{
  "name": "eventpay-sentinel",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time payment command center for mass events",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "groq-sdk": "^1.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "postcss": "^8.5.26",
    "razorpay": "^2.9.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.21.0",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.6"
  }
}
