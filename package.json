{
  "name": "eventpay-sentinel",
  "private": true,
  "version": "1.0.0",
  "description": "FormPay - Google Form to Razorpay payment automation",
  "workspaces": ["client", "server"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client",
    "start": "node server/src/index.js",
    "render-build": "npm install && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "google-auth-library": "^11.0.2",
    "groq-sdk": "^1.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "razorpay": "^2.9.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.21.0",
    "vite": "^7.3.6"
  }
}
